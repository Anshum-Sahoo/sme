{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Consent",
  "type": "object",
  "properties": {
    "consent_id": {
      "type": "string",
      "description": "Backend generated identifier"
    },
    "application_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED",
        "DATA_READY"
      ]
    },
    "requested_data": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "purpose": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "application_id",
    "requested_data",
    "purpose",
    "expires_at"
  ]
}